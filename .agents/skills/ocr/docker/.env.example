# Copy to docker/.env and edit. docker/.env is gitignored.

# Host folder of GGUF files (mounted read-only at /models).
MODELS_DIR=/home/hec/models/gguf

# Paths relative to MODELS_DIR.
OCR_MODEL=DeepSeek-OCR-2/deepseek-ocr-2-q8_0.gguf
OCR_MMPROJ=DeepSeek-OCR-2/mmproj-deepseek-ocr-2-q8_0.gguf

# OpenAI-compatible alias returned by /v1/models and used by the skill.
OCR_ALIAS=ocr

# Host port (8080 is often taken by llama-vulkan-strix llm).
OCR_PORT=8090

# GPU offload and context. OCR pages are short; 8k is enough for most docs.
OCR_NGL=99
OCR_CTX=8192
OCR_PARALLEL=1

# Sampling: 0 temp + top_k 1 for stable OCR.
OCR_TEMP=0.0
OCR_TOP_K=1

# Strix Halo / AMD render node groups (same as llama-vulkan-strix):
#   getent group render | cut -d: -f3
#   getent group video  | cut -d: -f3
RENDER_GID=990
VIDEO_GID=44
