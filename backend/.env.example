# Copy to .env and edit. Every value here has a working default —
# MOSAIC runs with this file absent.

# --- LLM -------------------------------------------------------------------
# auto = use Gemini when GOOGLE_API_KEY is set, otherwise the deterministic
# offline extractor. Get a free key at https://aistudio.google.com/apikey
LLM_PROVIDER=
GOOGLE_API_KEY= 
GEMINI_MODEL=

# --- Storage ---------------------------------------------------------------
# SQLite by default. For Postgres: postgresql+psycopg://mosaic:mosaic@localhost:5432/mosaic
# DATABASE_URL=sqlite:///./data/mosaic.db

# sql | neo4j
GRAPH_BACKEND=sql
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=mosaic-dev

# sqlite | qdrant
VECTOR_BACKEND=sqlite
# QDRANT_URL=http://localhost:6333

# local (hashing, no download) | sentence-transformers
EMBEDDING_BACKEND=local

# --- Research --------------------------------------------------------------
# Off by default so the demo is reproducible offline. Turn on to poll real
# RSS feeds and fetch pasted URLs.
ENABLE_NETWORK_RESEARCH=false
NEWSAPI_KEY=
TAVILY_API_KEY=

# --- Monitoring ------------------------------------------------------------
ENABLE_SCHEDULER=true
MONITOR_INTERVAL_MINUTES=30
ALERT_CONFIDENCE_FLOOR=0.55

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_USER_NAME=Saniya
DEMO_USER_EMAIL=demo@mosaic.local
